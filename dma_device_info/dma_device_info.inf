;
; dma_device_info.inf
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System ; TODO: specify appropriate Class
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318} ; TODO: specify appropriate ClassGuid
Provider    = %ManufacturerName%
CatalogFile = dma_device_info.cat
DriverVer   = ; TODO: set DriverVer in stampinf property pages
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
dma_device_info.sys = 1,,

;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName% = Standard,NT$ARCH$.10.0...16299 ; %13% support introduced in build 16299

[Standard.NT$ARCH$.10.0...16299]
%dma_device_info.DeviceDesc% = dma_device_info_Device, Root\dma_device_info ; TODO: edit hw-id

[dma_device_info_Device.NT]
CopyFiles = File_Copy

[File_Copy]
dma_device_info.sys

;-------------- Service installation
[dma_device_info_Device.NT.Services]
AddService = dma_device_info,%SPSVCINST_ASSOCSERVICE%, dma_device_info_Service_Inst

; -------------- dma_device_info driver install sections
[dma_device_info_Service_Inst]
DisplayName    = %dma_device_info.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\dma_device_info.sys

[dma_device_info_Device.NT.Wdf]
KmdfService = dma_device_info, dma_device_info_wdfsect

[dma_device_info_wdfsect]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ManufacturerName = "<Your manufacturer name>" ;TODO: Replace with your manufacturer name
DiskName = "dma_device_info Installation Disk"
dma_device_info.DeviceDesc = "dma_device_info Device"
dma_device_info.SVCDESC = "dma_device_info Service"
